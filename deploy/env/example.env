# ~ghrunner/.config/homelab-runners/<repo>.env, e.g. media-gallery.env
# Read with podman --env-file: KEY=value per line, no quotes, no expansion.
# Nothing in here is secret; the App private key is a podman secret.

# App ID (number) or Client ID (Iv23...) of the GitHub App.
GITHUB_APP_ID=123456
# Repository to register the runner for. Must be private (see README).
RUNNER_REPOSITORY=GiDW/media-gallery

# Optional, defaults shown:
#RUNNER_LABELS=self-hosted,Linux,X64,home
#RUNNER_GROUP_ID=1
#RUNNER_NAME_PREFIX=home-media-gallery
#RUNNER_FAIL_DELAY=30
